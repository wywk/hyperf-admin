# ================= Hyperf Admin 生产部署环境变量示例 =================
# 使用：cp .env.prod.example .env.prod，修改必填项后：
#      docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ---------- 必填 ----------

# JWT 签名密钥（必填，泄露等于丢掉整个系统）。生成：openssl rand -base64 48
JWT_SECRET=

# 数据库账号密码（必填，同时用于初始化 MySQL 容器）
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---------- 常用可选项 ----------

# 数据库名与业务账号（MySQL 容器首次启动时创建）
DB_DATABASE=hyperf_admin
DB_USERNAME=hyperf
# 统一表前缀
DB_PREFIX=ha_

# 浏览器访问端口（Nginx 容器映射到宿主的端口）
WEB_PORT=8000

# 后端 API 直连端口（如不需要可直接访问 9501，可注释 compose 里的 ports）
APP_PORT=9501

# 初始管理员 admin 的密码（仅首次 db:seed 生效）
SEED_ADMIN_PASSWORD=admin123456

# 登录失败限流：同一 IP + 用户名失败 N 次锁定 M 秒
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900

# 是否信任 X-Forwarded-For（套了 Nginx/负载均衡时设为 true，否则日志里记录的是代理 IP）
# 注意：本栈自带 web 容器已在代理层设置 X-Real-IP，保持 false 即可正确记录
TRUST_PROXY=false

# 审计日志保留天数
LOGIN_LOG_RETENTION_DAYS=90
OPERATION_LOG_RETENTION_DAYS=180

# 定时任务连续失败告警阈值与可选 webhook（留空则只写 stdout 日志）
# CRONTAB_FAIL_ALERT_THRESHOLD=3
# ALERT_WEBHOOK_URL=
