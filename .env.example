APP_NAME=hyperf-skeleton
APP_ENV=dev
APP_TIMEZONE=Asia/Shanghai

# dnmp 环境：mysql5 容器（宿主 127.0.0.1:3305）
DB_DRIVER=mysql
DB_HOST=mysql5
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=hyperf
DB_PASSWORD=hyperf123456
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=ha_

# dnmp 环境：redis 容器（宿主 127.0.0.1:6379，无密码）
REDIS_HOST=redis
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0

# JWT 签名密钥，用 openssl rand -hex 32 生成后替换
JWT_SECRET=
JWT_ALGO=HS256
JWT_ISSUER=hyperf-skeleton
# token 有效期（秒）
JWT_TTL=7200
# refresh token 有效期（秒），默认 7 天
JWT_REFRESH_TTL=604800

# 允许跨域的来源，多个用逗号分隔，* 表示全部
CORS_ALLOW_ORIGINS=*

# 登录失败限流：同一 IP + 用户名失败 N 次后锁定 M 秒
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900
# 是否信任 X-Forwarded-For（仅当请求必经自有反向代理时开启）
TRUST_PROXY=false

# 登录审计日志：开关与保留天数
LOGIN_LOG_ENABLED=true
LOGIN_LOG_RETENTION_DAYS=90

# 执行 db:seed 时的初始账号密码
SEED_ADMIN_PASSWORD=admin123456
